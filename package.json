{
  "name": "perilune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perilune — an original browser-based orbital engineering game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "validate:content": "node scripts/validate-content.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/three": "^0.170.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
