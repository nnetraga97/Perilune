{
  "name": "perilune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perilune — an original browser-based orbital engineering game",
  "scripts": {
    "predev": "npm run sync:renderer-assets",
    "dev": "vite",
    "prebuild": "npm run validate:content && npm run sync:renderer-assets && npm run check:launch-site",
    "build": "tsc --noEmit && vite build",
    "migrate:cloud": "node scripts/apply-cloud-migration.mjs",
    "backfill:cloud-fingerprints": "tsx scripts/backfill-cloud-save-fingerprints.mjs",
    "deploy-build": "npm run build",
    "preview": "vite preview",
    "serve": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "validate:content": "npm run check:sol-constants && npm run check:height-authority && npm run check:surface-class-authority && node scripts/validate-content.mjs && tsx scripts/validate-game-content.ts",
    "compile:planet-assets": "tsx scripts/compile-planet-assets.ts",
    "compile:height-authority": "node scripts/compile-height-authority.mjs",
    "compile:ksc-launch-authority": "tsx scripts/compile-ksc-launch-authority.ts",
    "compile:moon-site01-authority": "node scripts/compile-moon-site01-authority.mjs",
    "compile:surface-class-authority": "tsx scripts/compile-surface-class-authority.ts",
    "check:surface-class-authority": "tsx scripts/compile-surface-class-authority.ts",
    "check:height-authority": "tsx scripts/check-height-authority-artifact.ts",
    "check:height-authority:source": "node scripts/compile-height-authority.mjs --check",
    "fetch:local-material-sources": "node scripts/fetch-local-material-sources.mjs",
    "fetch:sol-constants": "node scripts/fetch-sol-constants.mjs",
    "fetch:mars-albedo-source": "node scripts/fetch-mars-albedo-source.mjs",
    "fetch:mercury-albedo-source": "node scripts/fetch-mercury-albedo-source.mjs",
    "fetch:venus-albedo-source": "node scripts/fetch-venus-albedo-source.mjs",
    "fetch:jupiter-albedo-source": "node scripts/fetch-jupiter-albedo-source.mjs",
    "fetch:callisto-albedo-source": "node scripts/fetch-callisto-albedo-source.mjs",
    "compile:sol-constants": "node scripts/compile-sol-constants.mjs",
    "check:sol-constants": "node scripts/compile-sol-constants.mjs --check",
    "compile:planet-assets:container": "node scripts/compile-planet-assets-container.mjs",
    "fetch:part-sources": "node scripts/fetch-part-sources.mjs",
    "compile:part-assets": "node scripts/compile-part-assets.mjs",
    "compile:part-assets:container": "node scripts/compile-part-assets-container.mjs",
    "sync:renderer-assets": "node scripts/sync-renderer-assets.mjs",
    "profile:feasibility": "node scripts/profile-feasibility.mjs",
    "profile:reentry": "tsx scripts/profile-reentry.ts",
    "fetch:planet-source": "node scripts/fetch-planet-source.mjs",
    "probe:planet-sources": "node scripts/probe-planet-detail-sources.mjs",
    "probe:moon-sun-sources": "node scripts/probe-moon-sun-sources.mjs",
    "inspect:planet-authority": "node --import tsx scripts/inspect-planet-authority.mjs",
    "fetch:surface-class-sources": "node scripts/fetch-surface-class-sources.mjs",
    "compile:launch-site": "tsx scripts/compile-launch-site.ts",
    "check:launch-site": "tsx scripts/check-launch-site.ts"
  },
  "dependencies": {
    "@sentry/browser": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "@supabase/supabase-js": "^2.110.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "redis": "^6.1.0",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.9.13"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.3.0",
    "@gltf-transform/core": "4.3.0",
    "@gltf-transform/extensions": "4.3.0",
    "@gltf-transform/functions": "4.3.0",
    "@playwright/test": "^1.49.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "22.20.1",
    "@types/three": "^0.170.0",
    "draco3dgltf": "1.5.7",
    "fast-check": "^3.23.0",
    "meshoptimizer": "1.0.1",
    "postgres": "^3.4.9",
    "sharp": "0.35.3",
    "tsx": "4.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.10"
  }
}
