{
  "name": "perilune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Perilune — an original browser-based orbital engineering game",
  "scripts": {
    "predev": "npm run sync:renderer-assets",
    "dev": "vite",
    "prebuild": "npm run validate:content && npm run sync:renderer-assets",
    "build": "tsc --noEmit && vite build",
    "migrate:cloud": "node scripts/apply-cloud-migration.mjs",
    "vercel-build": "npm run migrate:cloud && npm run build",
    "preview": "vite preview",
    "serve": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "validate:content": "node scripts/validate-content.mjs",
    "compile:planet-assets": "tsx scripts/compile-planet-assets.ts",
    "compile:planet-assets:container": "node scripts/compile-planet-assets-container.mjs",
    "fetch:part-sources": "node scripts/fetch-part-sources.mjs",
    "compile:part-assets": "node scripts/compile-part-assets.mjs",
    "compile:part-assets:container": "node scripts/compile-part-assets-container.mjs",
    "sync:renderer-assets": "node scripts/sync-renderer-assets.mjs",
    "profile:feasibility": "node scripts/profile-feasibility.mjs",
    "fetch:planet-source": "node scripts/fetch-planet-source.mjs"
  },
  "dependencies": {
    "@sentry/browser": "^10.65.0",
    "@sentry/node": "^10.65.0",
    "@supabase/supabase-js": "^2.110.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "redis": "^6.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.3.0",
    "@gltf-transform/core": "4.3.0",
    "@gltf-transform/extensions": "4.3.0",
    "@gltf-transform/functions": "4.3.0",
    "@playwright/test": "^1.49.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "22.20.1",
    "@types/three": "^0.170.0",
    "draco3dgltf": "1.5.7",
    "fast-check": "^3.23.0",
    "meshoptimizer": "1.0.1",
    "postgres": "^3.4.9",
    "sharp": "0.35.3",
    "tsx": "4.23.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.10"
  }
}
